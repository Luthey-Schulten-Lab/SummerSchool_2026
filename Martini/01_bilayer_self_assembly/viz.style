# source ../files/lipids.style
# Lipid tails.
mol selection lipid
mol color ColorID 19
mol representation Licorice 3 12 12 0 1
mol material AOChalky
mol addrep $molid
# Lipid head group.
mol selection lipid and headgroup
mol color ColorID 7
mol representation VDW 0.8
mol material AOChalky
mol addrep $molid


# source ../files/solvent.style
# Solvent.
mol selection name W NA CL
mol color ColorID 8
mol representation QuickSurf 0.6 0.5 0.5 1
mol material GlassBubble
mol addrep $molid
set repid [expr [molinfo $molid get numreps] - 1]
mol showrep $molid $repid 0

# Ions.
mol selection name NA CL
mol color Name
mol representation VDW 0.2
mol material AOShiny
mol addrep $molid
set repid [expr [molinfo $molid get numreps] - 1]
mol showrep $molid $repid 0
