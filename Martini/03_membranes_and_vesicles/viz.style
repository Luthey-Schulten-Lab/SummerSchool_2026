# Lipid tails followed by headgroups.
mol selection resname POPC
mol color ColorID 19
mol representation VDW 0.6
mol material AOChalky
mol addrep $molid
mol selection resname POPC and headgroup
mol color ColorID 7
mol representation VDW 0.8
mol material AOChalky
mol addrep $molid

mol selection resname DOPC CDL2
mol color ColorID 22
mol representation VDW 0.6
mol material AOChalky
mol addrep $molid
mol selection resname DOPC CDL2 and headgroup
mol color ColorID 10
mol representation VDW 0.8
mol material AOChalky
mol addrep $molid


# Proteins.
mol selection proteinbb
mol color ColorID 8
mol representation QuickSurf 1.0 0.5 0.5 1.0
mol material AOChalky
mol addrep $molid


# Surface points.
mol selection resname Ver
mol color Name
mol representation VDW 0.2
mol material AOShiny
mol addrep $molid


# Wall points.
mol selection resname Wall
mol color ColorID 5
mol representation VDW 0.5
mol material AOChalky
mol addrep $molid
